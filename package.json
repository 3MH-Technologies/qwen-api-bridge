{
  "name": "qwen-api-bridge",
  "version": "1.0.0",
  "description": "Tool bridge for chat.qwen.ai internal APIs: session recorder + one typed tool per endpoint",
  "type": "module",
  "main": "./src/client.js",
  "exports": {
    ".": "./src/client.js",
    "./client": "./src/client.js",
    "./routes": "./src/routes.js",
    "./session": "./src/session.js",
    "./sse": "./src/sse.js",
    "./chat": "./src/chat.js",
    "./recorder": "./src/recorder.js",
    "./inpage": "./src/inpage.js",
    "./tools": "./src/tools/build.js"
  },
  "bin": {
    "qwen": "./src/cli.js"
  },
  "scripts": {
    "record": "node src/cli.js record",
    "models": "node src/cli.js models",
    "configs": "node src/cli.js configs",
    "chat": "node src/cli.js chat",
    "tools": "node src/cli.js tools",
    "routes": "node src/cli.js routes",
    "auth-status": "node src/cli.js auth-status",
    "test": "node --test",
    "test:js": "node --test",
    "test:legacy": "node selftest.mjs",
    "test:py": "python selftest_qwen_session.py",
    "test:all": "npm run test:js && npm run test:legacy && npm run test:py",
    "lint": "eslint .",
    "prepublishOnly": "npm run test:all && npm run lint"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/3MH-Technologies/qwen-api-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/3MH-Technologies/qwen-api-bridge/issues"
  },
  "homepage": "https://github.com/3MH-Technologies/qwen-api-bridge#readme",
  "keywords": [
    "qwen",
    "chat-qwen-ai",
    "api-bridge",
    "sse",
    "cli",
    "alibaba"
  ],
  "author": {
    "name": "3MH TECHNOLOGIES",
    "url": "https://3mh.pages.dev/",
    "email": ""
  },
  "contributors": [
    {
      "name": "3MH TECHNOLOGIES",
      "url": "https://t.me/j49_c"
    }
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.13.0"
  }
}
